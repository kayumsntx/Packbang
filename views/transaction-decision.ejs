<%- include('partials/header') %>

<div style="display: flex; align-items: center; justify-content: center; min-height: 70vh; font-family: system-ui, -apple-system, sans-serif;">
    <div style="background: #ffffff; padding: 40px; border-radius: 16px; box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.1), 0 8px 10px -6px rgba(0, 0, 0, 0.05); max-width: 450px; width: 100%; border: 1px solid #e2e8f0; text-align: center;">
        
        <div style="font-size: 3.5rem; margin-bottom: 15px;">🛒</div>
        <h2 style="margin: 0 0 10px 0; color: #1a202c; font-size: 1.6rem; font-weight: 700;">Transaction Completed!</h2>
        <p style="color: #4a5568; margin: 0 0 30px 0; font-size: 1rem; line-height: 1.5;">
            The order has been finalized and recorded successfully. <br>
            <strong>Would you like to process another transaction?</strong>
        </p>

        <div style="display: flex; gap: 16px; justify-content: center;">
            <a href="/terminal" style="flex: 1; background: #3182ce; color: white; text-decoration: none; padding: 14px; border-radius: 8px; font-weight: 600; font-size: 1rem; box-shadow: 0 4px 12px rgba(49, 130, 206, 0.25);">
                Yes, Continue
            </a>
            
            <a href="/logout" style="flex: 1; background: #edf2f7; color: #4a5568; text-decoration: none; padding: 14px; border-radius: 8px; font-weight: 600; font-size: 1rem; border: 1px solid #cbd5e0;">
                No, Log Out
            </a>
        </div>
    </div>
</div>

<%- include('partials/footer') %>