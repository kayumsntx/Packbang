<%- include('partials/header') %>

<style>
    .my-orders-page { max-width: 1100px; margin: 40px auto; padding: 20px; }

    /* ===== PAGE HEADER ===== */
    .page-header { display: flex; justify-content: space-between; align-items: center; border-bottom: 3px solid #f39c12; padding-bottom: 18px; margin-bottom: 28px; flex-wrap: wrap; gap: 12px; }
    .page-header h2 { display: flex; align-items: center; gap: 12px; color: #1a202c; font-size: 1.5rem; }
    .page-header h2 i { color: #f39c12; }
    .page-header .order-count { background: #edf2f7; color: #4a5568; padding: 6px 16px; border-radius: 20px; font-size: 0.85rem; font-weight: 600; }

    /* ===== ORDER CARD (TruckLagbe Style) ===== */
    .order-card { background: white; border-radius: 14px; border: 1px solid #e2e8f0; padding: 22px 26px; margin-bottom: 20px; transition: all 0.3s ease; position: relative; overflow: hidden; }
    .order-card:hover { box-shadow: 0 8px 30px rgba(0, 0, 0, 0.08); border-color: #f39c12; transform: translateY(-2px); }
    .order-card::before { content: ''; position: absolute; top: 0; left: 0; width: 5px; height: 100%; background: #e2e8f0; transition: background 0.3s ease; }
    .order-card.status-pending::before { background: #f39c12; }
    .order-card.status-approved::before { background: #27ae60; }
    .order-card.status-rejected::before { background: #e53e3e; }
    .order-card.status-assigned::before { background: #3182ce; }
    .order-card.status-completed::before { background: #6b46c1; }

    .order-card .order-header { display: flex; justify-content: space-between; align-items: flex-start; flex-wrap: wrap; gap: 10px; margin-bottom: 12px; }
    .order-card .order-title { font-size: 1.15rem; font-weight: 700; color: #2d3748; margin: 0; }
    .order-card .order-id { font-size: 0.75rem; color: #a0aec0; font-weight: 500; margin-left: 10px; background: #f7fafc; padding: 2px 8px; border-radius: 6px; }

    /* ===== TIMER (24 Hours Countdown) ===== */
    .timer-badge { display: inline-flex; align-items: center; gap: 6px; padding: 5px 14px; border-radius: 20px; font-size: 0.75rem; font-weight: 700; white-space: nowrap; animation: timerPulse 2s infinite; }
    .timer-badge .timer-value { font-family: 'Courier New', monospace; font-size: 0.85rem; }
    .timer-badge.bidding-open { background: #c6f6d5; color: #276749; }
    .timer-badge.bidding-closing { background: #fefcbf; color: #975a16; }
    .timer-badge.bidding-closed { background: #fed7d7; color: #9b2c2c; animation: none; }
    @keyframes timerPulse { 0%, 100% { transform: scale(1); } 50% { transform: scale(1.03); } }

    /* ===== STATUS BADGE ===== */
    .status-badge { padding: 5px 16px; border-radius: 20px; font-size: 0.7rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.5px; white-space: nowrap; }
    .status-pending { background: #fefcbf; color: #975a16; }
    .status-approved { background: #c6f6d5; color: #276749; }
    .status-rejected { background: #fed7d7; color: #9b2c2c; }
    .status-assigned { background: #bee3f8; color: #2a69ac; }
    .status-completed { background: #e9d8fd; color: #6b46c1; }

    /* ===== META INFO ===== */
    .order-card .order-meta { display: flex; flex-wrap: wrap; gap: 14px 24px; font-size: 0.85rem; color: #718096; margin: 10px 0 14px 0; }
    .order-card .order-meta span { display: flex; align-items: center; gap: 6px; background: #f7fafc; padding: 4px 12px; border-radius: 8px; }
    .order-card .order-meta i { width: 16px; color: #a0aec0; }

    /* ===== DESCRIPTION ===== */
    .order-card .order-description { font-size: 0.92rem; color: #4a5568; line-height: 1.7; margin: 10px 0 14px 0; padding: 14px 18px; background: #f7fafc; border-radius: 10px; border-left: 4px solid #f39c12; }

    /* ===== IMAGE GALLERY ===== */
    .order-images { display: flex; gap: 12px; flex-wrap: wrap; margin: 14px 0; }
    .order-images .img-thumb { width: 80px; height: 80px; object-fit: cover; border-radius: 10px; border: 2px solid #e2e8f0; transition: all 0.3s ease; cursor: pointer; }
    .order-images .img-thumb:hover { border-color: #f39c12; transform: scale(1.08); box-shadow: 0 4px 15px rgba(243, 156, 18, 0.3); }

    /* ===== BID INFO (TruckLagbe Style) ===== */
    .bid-info { background: linear-gradient(135deg, #f7fafc 0%, #edf2f7 100%); border-radius: 12px; padding: 16px 20px; margin-top: 14px; border: 1px solid #e2e8f0; }
    .bid-info .bid-header { display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 8px; }
    .bid-info .bid-header strong { color: #2d3748; display: flex; align-items: center; gap: 6px; }
    .bid-info .bid-amount { font-weight: 800; color: #2b6cb0; font-size: 1.1rem; }
    .bid-info .bid-status { font-size: 0.7rem; font-weight: 700; padding: 3px 14px; border-radius: 12px; }
    .bid-status-accepted { background: #c6f6d5; color: #276749; }
    .bid-status-pending { background: #fefcbf; color: #975a16; }
    .bid-status-rejected { background: #fed7d7; color: #9b2c2c; }

    /* ===== ADMIN NOTE ===== */
    .admin-note { background: #ebf8ff; border-left: 4px solid #3182ce; padding: 12px 16px; border-radius: 8px; font-size: 0.85rem; color: #2a69ac; margin-top: 12px; }
    .admin-note strong { color: #1a365d; }

    /* ===== EMPTY STATE ===== */
    .empty-state { text-align: center; padding: 80px 20px; color: #a0aec0; }
    .empty-state i { font-size: 4rem; display: block; margin-bottom: 16px; color: #e2e8f0; }
    .empty-state h3 { color: #4a5568; margin-bottom: 8px; }
    .empty-state .btn-shop { display: inline-block; margin-top: 16px; padding: 12px 32px; background: linear-gradient(45deg, #f39c12, #e67e22); color: white; border-radius: 10px; text-decoration: none; font-weight: 700; transition: all 0.3s ease; }
    .empty-state .btn-shop:hover { transform: translateY(-2px); box-shadow: 0 6px 25px rgba(243, 156, 18, 0.4); }

    /* ===== RESPONSIVE ===== */
    @media (max-width: 768px) {
        .my-orders-page { padding: 12px; }
        .order-card { padding: 16px 18px; }
        .order-card .order-header { flex-direction: column; align-items: flex-start; }
        .order-card .order-meta { flex-direction: column; gap: 6px; }
        .order-images .img-thumb { width: 60px; height: 60px; }
        .bid-info .bid-header { flex-direction: column; align-items: flex-start; }
        .timer-badge { width: 100%; justify-content: center; }
    }

    @media (max-width: 480px) {
        .page-header h2 { font-size: 1.1rem; }
        .order-card .order-title { font-size: 1rem; }
        .order-card .order-description { font-size: 0.82rem; padding: 10px 12px; }
        .order-images .img-thumb { width: 50px; height: 50px; }
    }
</style>

<div class="my-orders-page">
    <!-- ===== HEADER ===== -->
    <div class="page-header">
        <h2><i class="fas fa-list-ul"></i> My Custom Orders</h2>
        <span class="order-count"><i class="fas fa-file-alt"></i> <%= orders ? orders.length : 0 %> order(s)</span>
    </div>

    <!-- ===== ORDERS LIST ===== -->
    <% if (orders && orders.length > 0) { %>
        <% orders.forEach(order => { %>
            <div class="order-card status-<%= order.status %>">
                <!-- Header -->
                <div class="order-header">
                    <div>
                        <span class="order-title">
                            <%= order.title %>
                            <span class="order-id">#<%= order.id %></span>
                        </span>
                    </div>
                    <div style="display:flex; gap:8px; align-items:center; flex-wrap:wrap;">
                        <!-- ✅ ২৪ ঘণ্টার কাউন্টডাউন টাইমার -->
                      <div class="timer-badge" 
     data-start-time="<%= order.status === 'approved' ? new Date(order.updatedAt).getTime() : new Date(order.createdAt).getTime() %>" 
     data-order-status="<%= order.status %>">
                            <i class="fas fa-clock"></i> <span class="timer-value">--:--:--</span>
                        </div>
                        <span class="status-badge status-<%= order.status %>">
                            <i class="fas <%= order.status === 'pending' ? 'fa-clock' : (order.status === 'approved' ? 'fa-check-circle' : (order.status === 'rejected' ? 'fa-times-circle' : (order.status === 'assigned' ? 'fa-user-check' : 'fa-check-double'))) %>"></i>
                            <%= order.status.charAt(0).toUpperCase() + order.status.slice(1) %>
                        </span>
                    </div>
                </div>

                <!-- Meta Info -->
                <div class="order-meta">
                    <span><i class="fas fa-calendar-alt"></i> <%= new Date(order.createdAt).toLocaleDateString('en-BD', { day: '2-digit', month: 'short', year: 'numeric' }) %></span>
                    <% if (order.budget && order.budget > 0) { %>
                        <span><i class="fas fa-money-bill-wave"></i> Budget: BDT. <%= order.budget.toFixed(2) %></span>
                    <% } %>
                    <% if (order.quantity && order.quantity > 1) { %>
                        <span><i class="fas fa-cubes"></i> Qty: <%= order.quantity %></span>
                    <% } %>
                    <% if (order.deadline) { %>
                        <span><i class="fas fa-hourglass-end"></i> Deadline: <%= new Date(order.deadline).toLocaleDateString('en-BD', { day: '2-digit', month: 'short', year: 'numeric' }) %></span>
                    <% } %>
                </div>

                <!-- Description -->
                <div class="order-description"><%= order.description %></div>

                <!-- Images -->
                <% if (order.images && order.images.length > 0) { %>
                    <div class="order-images">
                        <% order.images.forEach(img => { %>
                            <img src="<%= img %>" alt="Reference Image" class="img-thumb" onclick="window.open('<%= img %>', '_blank')">
                        <% }) %>
                    </div>
                <% } %>

                <!-- Admin Notes -->
                <% if (order.adminNotes) { %>
                    <div class="admin-note"><strong><i class="fas fa-user-shield"></i> Admin Note:</strong> <%= order.adminNotes %></div>
                <% } %>

                <!-- ✅ Assigned Bid Info -->
                <% if ((order.status === 'assigned' || order.status === 'completed') && order.selectedBidId) { %>
                    <% const selectedBid = order.bids.find(b => b._id.toString() === order.selectedBidId.toString()); %>
                    <% if (selectedBid) { %>
                        <div class="bid-info">
                            <div class="bid-header">
                                <div>
                                    <strong><i class="fas fa-handshake"></i> Assigned to:</strong>
                                    <%= selectedBid.sellerName %>
                                    <span style="font-size:0.8rem; color:#718096; margin-left:8px;">(Bid: <span class="bid-amount">BDT. <%= selectedBid.amount.toFixed(2) %></span>)</span>
                                </div>
                                <span class="bid-status bid-status-accepted"><i class="fas fa-check-circle"></i> Accepted</span>
                            </div>
                            <% if (selectedBid.deliveryTime) { %>
                                <div style="margin-top:6px; font-size:0.8rem; color:#718096;"><i class="fas fa-truck"></i> Delivery: <%= selectedBid.deliveryTime %></div>
                            <% } %>
                            <% if (selectedBid.note) { %>
                                <div style="margin-top:4px; font-size:0.8rem; color:#718096;"><i class="fas fa-comment"></i> Note: <%= selectedBid.note %></div>
                            <% } %>
                        </div>
                    <% } %>
                <% } %>

                <!-- Pending Info -->
                <% if (order.status === 'pending') { %>
                    <div style="margin-top:12px; font-size:0.8rem; color:#a0aec0;">
                        <i class="fas fa-info-circle"></i> This order is waiting for admin approval.
                        <span style="display:block; margin-top:4px; font-size:0.75rem;"><i class="fas fa-clock"></i> Submitted on <%= new Date(order.createdAt).toLocaleString() %></span>
                    </div>
                <% } %>

                <!-- Rejected Info -->
                <% if (order.status === 'rejected') { %>
                    <div style="margin-top:12px; font-size:0.8rem; color:#e53e3e;">
                        <i class="fas fa-exclamation-circle"></i> This order has been rejected by the admin.
                        <% if (order.adminNotes) { %><br><span style="color:#4a5568;"><strong>Reason:</strong> <%= order.adminNotes %></span><% } %>
                    </div>
                <% } %>

                <!-- Approved Info -->
                <% if (order.status === 'approved') { %>
                    <div style="margin-top:12px; font-size:0.8rem; color:#2b6cb0;">
                        <i class="fas fa-check-circle"></i> This order is approved and open for bidding.
                        <span style="display:block; margin-top:4px; font-size:0.75rem; color:#718096;"><i class="fas fa-users"></i> <%= order.bids ? order.bids.length : 0 %> bid(s) received</span>
                    </div>
                <% } %>

                <!-- Completed Info -->
                <% if (order.status === 'completed') { %>
                    <div style="margin-top:12px; font-size:0.8rem; color:#27ae60;">
                        <i class="fas fa-check-double"></i> This order has been completed successfully!
                        <span style="display:block; margin-top:4px; font-size:0.75rem; color:#718096;"><i class="fas fa-calendar-check"></i> Completed on <%= new Date(order.updatedAt).toLocaleDateString() %></span>
                    </div>
                <% } %>
            </div>
        <% }) %>
    <% } else { %>
        <!-- Empty State -->
        <div class="empty-state">
            <i class="fas fa-inbox"></i>
            <h3>No Custom Orders Yet</h3>
            <p>You haven't created any custom orders yet.</p>
            <a href="/custom-order" class="btn-shop"><i class="fas fa-pencil-alt"></i> Create Your First Custom Order</a>
        </div>
    <% } %>
</div>

<script>
    console.log('✅ My Custom Orders Page Loaded');

    // ============================================
    // ✅ ২৪ ঘণ্টার কাউন্টডাউন টাইমার (TruckLagbe Style)
    // ============================================
    // প্রতিটি অর্ডারের createdAt টাইমস্ট্যাম্প থেকে ২৪ ঘণ্টা যোগ করে
    // অবশিষ্ট সময় প্রতি সেকেন্ডে আপডেট করা হয়। ৬ ঘণ্টার কম হলে কমলা,
    // সময় শেষ হলে লাল রঙে "Bidding Closed" দেখানো হয়।

    document.querySelectorAll('.timer-badge').forEach(function (badge) {
    const startTime = parseInt(badge.getAttribute('data-start-time'), 10);
    const orderStatus = badge.getAttribute('data-order-status');

    // ✅ যে স্ট্যাটাসে টাইমার দেখানোর দরকার নেই
    if (orderStatus === 'rejected' || orderStatus === 'assigned' || orderStatus === 'completed') {
        badge.style.display = 'none';
        return;
    }

    // ✅ Pending (অ্যাডমিন অ্যাপ্রুভের অপেক্ষায়) — টাইমার লুকানো
    if (orderStatus === 'pending') {
        badge.style.display = 'none';
        return;
    }

    // ✅ Approved — এখানেই ২৪ ঘণ্টার কাউন্টডাউন চলবে
    const deadline = startTime + (24 * 60 * 60 * 1000);

    function updateTimer() {
        const now = Date.now();
        const remaining = deadline - now;

        if (remaining <= 0) {
            badge.className = 'timer-badge bidding-closed';
            badge.querySelector('.timer-value').textContent = 'Bidding Closed';
            clearInterval(timerInterval);
            return;
        }

        const hours = Math.floor(remaining / (1000 * 60 * 60));
        const minutes = Math.floor((remaining % (1000 * 60 * 60)) / (1000 * 60));
        const seconds = Math.floor((remaining % (1000 * 60)) / 1000);

        const formatted = `${String(hours).padStart(2, '0')}:${String(minutes).padStart(2, '0')}:${String(seconds).padStart(2, '0')}`;
        badge.querySelector('.timer-value').textContent = formatted;

        if (remaining <= 6 * 60 * 60 * 1000) {
            badge.className = 'timer-badge bidding-closing';
        } else {
            badge.className = 'timer-badge bidding-open';
        }
    }

    updateTimer();
    const timerInterval = setInterval(updateTimer, 1000);
});
        const createdAt = parseInt(badge.getAttribute('data-created-at'), 10);
        const orderStatus = badge.getAttribute('data-order-status');

        // ইতিমধ্যে Approved/Assigned/Completed হলে টাইমার দেখানোর দরকার নেই
        if (orderStatus === 'approved' || orderStatus === 'assigned' || orderStatus === 'completed' || orderStatus === 'rejected') {
            badge.style.display = 'none';
            return;
        }

        const deadline = createdAt + (24 * 60 * 60 * 1000); // ২৪ ঘণ্টা পর

        function updateTimer() {
            const now = Date.now();
            const remaining = deadline - now;

            if (remaining <= 0) {
                badge.className = 'timer-badge bidding-closed';
                badge.querySelector('.timer-value').textContent = 'Bidding Closed';
                clearInterval(timerInterval);
                return;
            }

            const hours = Math.floor(remaining / (1000 * 60 * 60));
            const minutes = Math.floor((remaining % (1000 * 60 * 60)) / (1000 * 60));
            const seconds = Math.floor((remaining % (1000 * 60)) / 1000);

            const formatted = `${String(hours).padStart(2, '0')}:${String(minutes).padStart(2, '0')}:${String(seconds).padStart(2, '0')}`;
            badge.querySelector('.timer-value').textContent = formatted;

            // ৬ ঘণ্টার কম হলে কমলা ওয়ার্নিং
            if (remaining <= 6 * 60 * 60 * 1000) {
                badge.className = 'timer-badge bidding-closing';
            } else {
                badge.className = 'timer-badge bidding-open';
            }
        }

        updateTimer();
        const timerInterval = setInterval(updateTimer, 1000);
    

    // ============================================
    // ইমেজ ক্লিক করে বড় করে দেখানো
    // ============================================
    document.querySelectorAll('.img-thumb').forEach(img => {
        img.addEventListener('click', function () {
            window.open(this.src, '_blank');
        });
    });
</script>

<%- include('partials/footer') %>