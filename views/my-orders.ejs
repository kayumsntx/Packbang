<%- include('partials/header') %>

<style>
    .orders-page {
        max-width: 1200px;
        margin: 40px auto;
        padding: 20px;
    }

    .summary-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
        gap: 20px;
        margin-bottom: 30px;
    }

    .summary-card {
        background: white;
        border-radius: 12px;
        padding: 20px;
        border: 1px solid #e2e8f0;
        text-align: center;
        transition: all 0.3s ease;
    }

    .summary-card:hover {
        transform: translateY(-3px);
        box-shadow: 0 4px 20px rgba(0, 0, 0, 0.06);
    }

    .summary-card .number {
        font-size: 2rem;
        font-weight: 700;
        color: #2b6cb0;
        display: block;
    }

    .summary-card .label {
        font-size: 0.85rem;
        color: #718096;
        margin-top: 4px;
    }

    .summary-card .icon {
        font-size: 1.5rem;
        color: #f39c12;
        margin-bottom: 8px;
    }

    .orders-toolbar {
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 16px;
        background: #f7fafc;
        padding: 16px 20px;
        border-radius: 12px;
        border: 1px solid #e2e8f0;
        margin-bottom: 24px;
    }

    .orders-toolbar .filter-group {
        display: flex;
        gap: 12px;
        align-items: center;
        flex-wrap: wrap;
    }

    .orders-toolbar select {
        padding: 8px 14px;
        border: 2px solid #e2e8f0;
        border-radius: 8px;
        font-size: 0.9rem;
        outline: none;
        background: white;
        cursor: pointer;
        transition: all 0.3s ease;
    }

    .orders-toolbar select:focus {
        border-color: #3182ce;
        box-shadow: 0 0 0 3px rgba(49, 130, 206, 0.2);
    }

    .orders-toolbar .btn-download {
        padding: 8px 20px;
        background: linear-gradient(45deg, #27ae60, #2ecc71);
        color: white;
        border: none;
        border-radius: 8px;
        font-weight: 600;
        font-size: 0.9rem;
        cursor: pointer;
        transition: all 0.3s ease;
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .orders-toolbar .btn-download:hover {
        transform: translateY(-2px);
        box-shadow: 0 4px 15px rgba(46, 204, 113, 0.4);
    }

    .orders-toolbar .btn-download.pdf {
        background: linear-gradient(45deg, #e74c3c, #c0392b);
    }

    .orders-toolbar .btn-download.pdf:hover {
        box-shadow: 0 4px 15px rgba(231, 76, 60, 0.4);
    }

    .orders-toolbar .order-count-text {
        color: #4a5568;
        font-size: 0.9rem;
        font-weight: 500;
    }

    .order-card {
        background: white;
        border-radius: 12px;
        padding: 20px;
        margin-bottom: 16px;
        border: 1px solid #e2e8f0;
        transition: all 0.3s ease;
    }

    .order-card:hover {
        box-shadow: 0 4px 20px rgba(0, 0, 0, 0.06);
    }

    .order-card .order-top {
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 12px;
        border-bottom: 1px solid #edf2f7;
        padding-bottom: 12px;
        margin-bottom: 12px;
    }

    .order-card .order-id {
        font-family: monospace;
        font-size: 0.85rem;
        background: #f7fafc;
        padding: 4px 12px;
        border-radius: 6px;
        color: #4a5568;
    }

    .order-card .order-date {
        color: #718096;
        font-size: 0.85rem;
    }

    .status-badge {
        padding: 4px 14px;
        border-radius: 20px;
        font-size: 0.75rem;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.3px;
        display: inline-block;
        margin-left: 8px;
    }

    .status-badge.pending { background: #fefcbf; color: #975a16; }
    .status-badge.processing { background: #bee3f8; color: #2a69ac; }
    .status-badge.shipped { background: #c6f6d5; color: #276749; }
    .status-badge.delivered { background: #9ae6b4; color: #22543d; }
    .status-badge.cancelled { background: #fed7d7; color: #9b2c2c; }

    .order-card .order-items {
        display: flex;
        flex-direction: column;
        gap: 8px;
    }

    .order-card .order-item {
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 8px 0;
        border-bottom: 1px solid #f7fafc;
    }

    .order-card .order-item:last-child {
        border-bottom: none;
    }

    .order-card .order-item img {
        width: 48px;
        height: 48px;
        object-fit: cover;
        border-radius: 6px;
        border: 1px solid #e2e8f0;
    }

    .order-card .order-item .item-details {
        flex: 1;
    }

    .order-card .order-item .item-details .item-name {
        font-weight: 600;
        color: #2d3748;
    }

    .order-card .order-item .item-details .item-meta {
        font-size: 0.85rem;
        color: #718096;
    }

    .order-card .order-item .item-price {
        font-weight: 700;
        color: #2b6cb0;
    }

    .order-card .order-total {
        display: flex;
        justify-content: space-between;
        align-items: center;
        font-size: 1.1rem;
        font-weight: 700;
        color: #1a202c;
        padding-top: 12px;
        border-top: 2px solid #edf2f7;
        margin-top: 8px;
        flex-wrap: wrap;
        gap: 10px;
    }

    .order-card .order-total span {
        color: #2b6cb0;
    }

    .order-card .order-total .status-select {
        font-size: 0.85rem;
        padding: 4px 12px;
        border: 2px solid #e2e8f0;
        border-radius: 6px;
        outline: none;
        background: white;
        cursor: pointer;
    }

    .order-card .order-total .status-select:focus {
        border-color: #3182ce;
    }

    .grand-total {
        background: linear-gradient(135deg, #1a202c, #2d3748);
        color: white;
        padding: 16px 24px;
        border-radius: 12px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-top: 20px;
        flex-wrap: wrap;
        gap: 12px;
    }

    .grand-total .label {
        font-size: 1.1rem;
        font-weight: 600;
    }

    .grand-total .amount {
        font-size: 1.5rem;
        font-weight: 700;
        color: #f39c12;
    }


    .btn-track {
        background: #3182ce;
        color: white;
        border: none;
        padding: 6px 16px;
        border-radius: 6px;
        cursor: pointer;
        font-weight: 600;
        font-size: 0.85rem;
        transition: all 0.3s ease;
        display: inline-flex;
        align-items: center;
        gap: 6px;
    }

    .btn-track:hover {
        background: #2b6cb0;
        transform: translateY(-1px);
        box-shadow: 0 4px 15px rgba(49, 130, 206, 0.3);
    }

    .btn-qr {
        background: #f39c12;
        color: white;
        border: none;
        padding: 6px 16px;
        border-radius: 6px;
        cursor: pointer;
        font-weight: 600;
        font-size: 0.85rem;
        transition: all 0.3s ease;
        display: inline-flex;
        align-items: center;
        gap: 6px;
    }

    .btn-qr:hover {
        background: #e67e22;
        transform: translateY(-1px);
        box-shadow: 0 4px 15px rgba(243, 156, 18, 0.3);
    }


    .btn-slip {
        background: #27ae60;
        color: white;
        border: none;
        padding: 6px 16px;
        border-radius: 6px;
        cursor: pointer;
        font-weight: 600;
        font-size: 0.85rem;
        transition: all 0.3s ease;
        display: inline-flex;
        align-items: center;
        gap: 6px;
    }

    .btn-slip:hover {
        background: #2ecc71;
        transform: translateY(-1px);
        box-shadow: 0 4px 15px rgba(46, 204, 113, 0.3);
    }

    .order-total-right {
        display: flex;
        align-items: center;
        gap: 12px;
        flex-wrap: wrap;
    }

    .empty-orders {
        text-align: center;
        padding: 60px 20px;
        color: #a0aec0;
    }

    .empty-orders i {
        font-size: 4rem;
        color: #e2e8f0;
        display: block;
        margin-bottom: 16px;
    }

    .empty-orders h3 {
        color: #4a5568;
    }

    .empty-orders .btn-shop {
        display: inline-block;
        margin-top: 16px;
        padding: 12px 28px;
        background: linear-gradient(45deg, #3182ce, #2b6cb0);
        color: white;
        border-radius: 8px;
        text-decoration: none;
        font-weight: 600;
    }

    @media (max-width: 768px) {
        .orders-page { padding: 12px; }
        .summary-grid { grid-template-columns: repeat(2, 1fr); gap: 12px; }
        .summary-card .number { font-size: 1.5rem; }
        .orders-toolbar { flex-direction: column; align-items: stretch; }
        .orders-toolbar .filter-group { justify-content: center; }
        .order-card .order-top { flex-direction: column; align-items: flex-start; }
        .order-card .order-item { flex-wrap: wrap; }
        .order-card .order-total { flex-direction: column; align-items: flex-start; }
        .grand-total { flex-direction: column; text-align: center; }
        .order-total-right { width: 100%; justify-content: flex-start; }
    }

    @media (max-width: 480px) {
        .summary-grid { grid-template-columns: 1fr 1fr; gap: 10px; }
        .summary-card { padding: 14px; }
        .summary-card .number { font-size: 1.2rem; }
        .btn-track, .btn-qr, .btn-slip { font-size: 0.75rem; padding: 4px 12px; }
    }
</style>

<div class="orders-page">
  
    <div class="summary-grid">
        <div class="summary-card">
            <div class="icon"><i class="fas fa-shopping-bag"></i></div>
            <span class="number"><%= orderCount %></span>
            <span class="label">Total Orders</span>
        </div>
        <div class="summary-card">
            <div class="icon"><i class="fas fa-money-bill-wave"></i></div>
            <span class="number">BDT. <%= totalAmount %></span>
            <span class="label">Total Spent</span>
        </div>
        <div class="summary-card">
            <div class="icon"><i class="fas fa-calculator"></i></div>
            <span class="number">BDT. <%= averageAmount %></span>
            <span class="label">Average Per Order</span>
        </div>
        <div class="summary-card">
            <div class="icon"><i class="fas fa-clock"></i></div>
            <span class="number"><%= pendingCount %></span>
            <span class="label">Pending Orders</span>
        </div>
    </div>

  
    <div class="orders-toolbar">
        <div class="filter-group">
            <label style="font-weight: 600; color: #4a5568; font-size: 0.85rem;">
                <i class="fas fa-filter"></i> Filter:
            </label>
            <select id="statusFilter">
                <option value="all">All Orders</option>
                <option value="pending">Pending</option>
                <option value="processing">Processing</option>
                <option value="shipped">Shipped</option>
                <option value="delivered">Delivered</option>
                <option value="cancelled">Cancelled</option>
            </select>
            <span class="order-count-text" id="visibleCount">
                Showing <strong id="visibleCountNum"><%= orderCount %></strong> orders
            </span>
        </div>
        <div style="display: flex; gap: 10px; flex-wrap: wrap;">
            <button class="btn-download" onclick="downloadCSV()">
                <i class="fas fa-file-csv"></i> Download CSV
            </button>
            <button class="btn-download pdf" onclick="downloadPDF()">
                <i class="fas fa-file-pdf"></i> Download PDF
            </button>
        </div>
    </div>

 
    <div id="ordersList">
        <% if (orders && orders.length > 0) { %>
            <% 
                const groupedOrders = {};
                orders.forEach(order => {
                    if (!groupedOrders[order.saleId]) {
                        groupedOrders[order.saleId] = {
                            saleId: order.saleId,
                            customerName: order.customerName,
                            customerEmail: order.customerEmail,
                            customerAddress: order.customerAddress,
                            saleDate: order.saleDate,
                            status: order.status || 'Pending',
                            items: [],
                            totalAmount: 0
                        };
                    }
                    groupedOrders[order.saleId].items.push({
                        productName: order.productName,
                        price: order.price,
                        quantity: order.quantity,
                        totalAmount: order.totalAmount,
                        imagePath: order.imagePath
                    });
                    groupedOrders[order.saleId].totalAmount += order.totalAmount;
                });
                
                const groupedOrdersArray = Object.values(groupedOrders);
                groupedOrdersArray.sort((a, b) => new Date(b.saleDate) - new Date(a.saleDate));
            %>
            
            <% groupedOrdersArray.forEach(order => { %>
                <div class="order-card" data-status="<%= order.status.toLowerCase() %>">
                    <div class="order-top">
                        <div>
                            <span class="order-id">#<%= order.saleId %></span>
                            <span class="status-badge <%= order.status.toLowerCase() %>">
                                <%= order.status %>
                            </span>
                        </div>
                        <div class="order-date">
                            <i class="far fa-calendar-alt"></i>
                            <%= new Date(order.saleDate).toLocaleString('en-BD', {
                                day: '2-digit',
                                month: 'short',
                                year: 'numeric',
                                hour: '2-digit',
                                minute: '2-digit'
                            }) %>
                        </div>
                    </div>

                    <div class="order-items">
                        <% order.items.forEach(item => { %>
                            <div class="order-item">
                                <img src="<%= item.imagePath || '/uploads/default.jpg' %>" alt="<%= item.productName %>" />
                                <div class="item-details">
                                    <div class="item-name"><%= item.productName %></div>
                                    <div class="item-meta">
                                        Price: BDT. <%= item.price.toFixed(2) %> × <%= item.quantity %>
                                    </div>
                                </div>
                                <div class="item-price">BDT. <%= item.totalAmount.toFixed(2) %></div>
                            </div>
                        <% }) %>
                    </div>

                    <div class="order-total">
                        <span>Total: BDT. <%= order.totalAmount.toFixed(2) %></span>
                        <div class="order-total-right">
                         
                            <button class="btn-track" onclick="trackOrder('<%= order.saleId %>')">
                                <i class="fas fa-map-marked-alt"></i> Track
                            </button>
                            
                       
                            <button class="btn-qr" onclick="viewQR('<%= order.saleId %>')">
                                <i class="fas fa-qrcode"></i> QR
                            </button>
                     
                            <% if (order.status !== 'Pending' && order.status !== 'Cancelled') { %>
                                <button class="btn-slip" onclick="printPackingSlip('<%= order.saleId %>')">
                                    <i class="fas fa-file-invoice"></i> Slip
                                </button>
                            <% } %>
                           
                            <% if (typeof user !== 'undefined' && user && (user.role === 'admin' || user.username.toLowerCase() === 'admin' || user.isSuperAdmin === true)) { %>
                                <div>
                                    <label style="font-size: 0.8rem; color: #4a5568; font-weight: 600; margin-right: 6px;">
                                        <i class="fas fa-edit"></i> Status:
                                    </label>
                                    <select class="status-select" data-saleid="<%= order.saleId %>" onchange="updateOrderStatus(this)">
                                        <option value="pending" <%= order.status.toLowerCase() === 'pending' ? 'selected' : '' %>>Pending</option>
                                        <option value="processing" <%= order.status.toLowerCase() === 'processing' ? 'selected' : '' %>>Processing</option>
                                        <option value="shipped" <%= order.status.toLowerCase() === 'shipped' ? 'selected' : '' %>>Shipped</option>
                                        <option value="delivered" <%= order.status.toLowerCase() === 'delivered' ? 'selected' : '' %>>Delivered</option>
                                        <option value="cancelled" <%= order.status.toLowerCase() === 'cancelled' ? 'selected' : '' %>>Cancelled</option>
                                    </select>
                                </div>
                            <% } %>
                        </div>
                    </div>
                </div>
            <% }) %>

            <div class="grand-total">
                <span class="label"><i class="fas fa-chart-line"></i> Grand Total</span>
                <span class="amount">BDT. <%= totalAmount %></span>
            </div>

        <% } else { %>
            <div class="empty-orders">
                <i class="fas fa-box-open"></i>
                <h3>No Orders Found</h3>
                <p>You haven't placed any orders yet.</p>
                <a href="/" class="btn-shop">
                    <i class="fas fa-shopping-bag"></i> Start Shopping
                </a>
            </div>
        <% } %>
    </div>
</div>


<script>

    function trackOrder(saleId) {
        window.location.href = '/track-order/' + saleId;
    }

 
    function viewQR(saleId) {
        window.location.href = '/order/qr/' + saleId;
    }

  
    function printPackingSlip(saleId) {
        window.open('/packing-slip/' + saleId + '?print=true', '_blank');
    }


    $('#statusFilter').on('change', function() {
        var filter = $(this).val();
        var visibleCount = 0;

        $('.order-card').each(function() {
            var status = $(this).data('status');
            if (filter === 'all' || status === filter) {
                $(this).show();
                visibleCount++;
            } else {
                $(this).hide();
            }
        });

        $('#visibleCountNum').text(visibleCount);
        updateGrandTotalVisibility();
    });

    function updateGrandTotalVisibility() {
        if ($('.order-card:visible').length === 0) {
            $('.grand-total').hide();
        } else {
            $('.grand-total').show();
        }
    }

    function updateOrderStatus(select) {
        var saleId = $(select).data('saleid');
        var status = $(select).val();

        if (!confirm('Are you sure you want to change this order status to "' + status + '"?')) {
            $(select).val($(select).data('previous-value'));
            return;
        }

        $.ajax({
            url: '/api/order/status',
            type: 'POST',
            contentType: 'application/json',
            data: JSON.stringify({ saleId: saleId, status: status }),
            success: function(response) {
                if (response.success) {
                    var $card = $(select).closest('.order-card');
                    var $badge = $card.find('.status-badge');
                    var displayStatus = status.charAt(0).toUpperCase() + status.slice(1);
                    $badge.text(displayStatus);
                    $badge.removeClass('pending processing shipped delivered cancelled');
                    $badge.addClass(status);
                    $card.data('status', status);
                    showNotification('✅ Order status updated to ' + displayStatus, 'success');
                }
            },
            error: function() {
                showNotification('❌ Failed to update status', 'error');
            }
        });
    }

   
    $(document).on('focus', '.status-select', function() {
        $(this).data('previous-value', $(this).val());
    });

    function downloadCSV() {
        var rows = [];
        var headers = ['Order ID', 'Product', 'Price', 'Quantity', 'Total', 'Status', 'Date'];
        rows.push(headers.join(','));

        $('.order-card:visible').each(function() {
            var id = $(this).find('.order-id').text().trim();
            var status = $(this).find('.status-badge').text().trim();
            var date = $(this).find('.order-date').text().trim();
            
            $(this).find('.order-item').each(function() {
                var product = $(this).find('.item-name').text().trim();
                var price = $(this).find('.item-price').text().trim().replace('BDT. ', '');
                var qtyText = $(this).find('.item-meta').text().trim();
                var qtyMatch = qtyText.match(/× (\d+)/);
                var qty = qtyMatch ? qtyMatch[1] : '1';
                var total = price;
                rows.push([id, product, price, qty, total, status, date].join(','));
            });
        });

        var csv = rows.join('\n');
        var blob = new Blob([csv], { type: 'text/csv' });
        var link = document.createElement('a');
        link.href = URL.createObjectURL(blob);
        link.download = 'my_orders_' + new Date().toISOString().slice(0, 10) + '.csv';
        document.body.appendChild(link);
        link.click();
        document.body.removeChild(link);
        showNotification('📊 CSV downloaded successfully!', 'success');
    }

 
    function downloadPDF() {
        var printWindow = window.open('', '_blank', 'width=800,height=600');
        var content = '<html><head><title>My Orders</title>';
        content += '<style>';
        content += 'body { font-family: Arial, sans-serif; padding: 20px; }';
        content += 'h1 { color: #1a202c; border-bottom: 2px solid #f39c12; padding-bottom: 10px; }';
        content += '.order-card { border: 1px solid #e2e8f0; padding: 15px; margin-bottom: 15px; border-radius: 8px; }';
        content += '.order-top { display: flex; justify-content: space-between; border-bottom: 1px solid #eee; padding-bottom: 10px; margin-bottom: 10px; }';
        content += '.status-badge { padding: 2px 12px; border-radius: 12px; font-size: 12px; font-weight: bold; }';
        content += '.status-badge.pending { background: #fefcbf; }';
        content += '.status-badge.processing { background: #bee3f8; }';
        content += '.status-badge.shipped { background: #c6f6d5; }';
        content += '.status-badge.delivered { background: #9ae6b4; }';
        content += '.status-badge.cancelled { background: #fed7d7; }';
        content += '.order-total { font-weight: bold; font-size: 16px; margin-top: 10px; padding-top: 10px; border-top: 2px solid #eee; }';
        content += '.grand-total { background: #1a202c; color: white; padding: 15px 20px; border-radius: 8px; margin-top: 20px; display: flex; justify-content: space-between; font-size: 18px; }';
        content += '.grand-total .amount { color: #f39c12; font-weight: bold; }';
        content += '</style>';
        content += '</head><body>';
        content += '<h1>📦 My Orders</h1>';
        content += '<p>Generated on: ' + new Date().toLocaleString() + '</p>';

        $('.order-card:visible').each(function() {
            content += '<div class="order-card">';
            content += '<div class="order-top">';
            content += '<div><strong>' + $(this).find('.order-id').text().trim() + '</strong> ';
            content += '<span class="status-badge ' + $(this).data('status') + '">' + $(this).find('.status-badge').text().trim() + '</span></div>';
            content += '<div>' + $(this).find('.order-date').text().trim() + '</div>';
            content += '</div>';
            
            $(this).find('.order-item').each(function() {
                content += '<div style="display:flex; align-items:center; gap:10px; padding:5px 0; border-bottom:1px solid #f0f0f0;">';
                content += '<div><strong>' + $(this).find('.item-name').text().trim() + '</strong></div>';
                content += '<div style="flex:1;"></div>';
                content += '<div>' + $(this).find('.item-meta').text().trim() + '</div>';
                content += '<div style="font-weight:bold; color:#2b6cb0;">' + $(this).find('.item-price').text().trim() + '</div>';
                content += '</div>';
            });
            
            content += '<div class="order-total">' + $(this).find('.order-total span').text().trim() + '</div>';
            content += '</div>';
        });

        var grandTotalText = $('.grand-total .amount').text().trim();
        if (grandTotalText) {
            content += '<div class="grand-total"><span>Grand Total</span><span class="amount">' + grandTotalText + '</span></div>';
        }

        content += '</body></html>';
        printWindow.document.write(content);
        printWindow.document.close();
        printWindow.print();
        showNotification('📄 PDF opened for printing!', 'success');
    }

   
    function showNotification(message, type) {
        if (typeof window.showNotification === 'function') {
