<%- include('partials/header') %>

<style>

    .slip-page {
        max-width: 800px;
        margin: 40px auto;
        padding: 20px;
    }

    .slip-container {
        background: white;
        border-radius: 12px;
        padding: 40px;
        border: 1px solid #e2e8f0;
        box-shadow: 0 4px 30px rgba(0, 0, 0, 0.08);
    }

    .slip-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        border-bottom: 3px solid #f39c12;
        padding-bottom: 20px;
        margin-bottom: 24px;
    }

    .slip-header .brand {
        display: flex;
        align-items: center;
        gap: 12px;
    }

    .slip-header .brand .logo {
        font-size: 1.8rem;
        font-weight: 700;
        background: linear-gradient(45deg, #f39c12, #e67e22);
        -webkit-background-clip: text;
        background-clip: text;
        -webkit-text-fill-color: transparent;
    }

    .slip-header .brand .sub {
        font-size: 0.8rem;
        color: #718096;
    }

    .slip-header .slip-type {
        text-align: right;
    }

    .slip-header .slip-type h3 {
        color: #1a202c;
        font-size: 1.2rem;
        margin: 0;
        text-transform: uppercase;
        letter-spacing: 1px;
    }

    .slip-header .slip-type .status-badge {
        display: inline-block;
        padding: 4px 16px;
        border-radius: 20px;
        font-size: 0.75rem;
        font-weight: 600;
        text-transform: uppercase;
        margin-top: 4px;
    }

    .status-badge.pending { background: #fefcbf; color: #975a16; }
    .status-badge.processing { background: #bee3f8; color: #2a69ac; }
    .status-badge.shipped { background: #c6f6d5; color: #276749; }
    .status-badge.delivered { background: #9ae6b4; color: #22543d; }

    .order-info-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 20px;
        margin-bottom: 24px;
        background: #f7fafc;
        padding: 16px;
        border-radius: 8px;
    }

    .order-info-grid .info-item .label {
        font-size: 0.7rem;
        color: #718096;
        text-transform: uppercase;
        font-weight: 600;
        letter-spacing: 0.3px;
    }

    .order-info-grid .info-item .value {
        font-size: 0.95rem;
        font-weight: 600;
        color: #1a202c;
        margin-top: 2px;
    }

    .qr-section {
        display: flex;
        justify-content: center;
        align-items: center;
        gap: 20px;
        margin: 16px 0 24px 0;
        padding: 16px;
        background: #f7fafc;
        border-radius: 12px;
        border: 1px dashed #e2e8f0;
        flex-wrap: wrap;
    }

    .qr-section .qr-code {
        width: 120px;
        height: 120px;
        border: 2px solid #e2e8f0;
        border-radius: 8px;
        padding: 8px;
        background: white;
    }

    .qr-section .qr-code img {
        width: 100%;
        height: 100%;
        object-fit: contain;
    }

    .qr-section .qr-info {
        text-align: center;
    }

    .qr-section .qr-info .qr-label {
        font-size: 0.7rem;
        color: #718096;
        text-transform: uppercase;
        font-weight: 600;
        letter-spacing: 0.3px;
    }

    .qr-section .qr-info .qr-id {
        font-family: monospace;
        font-size: 0.8rem;
        color: #2b6cb0;
        font-weight: 600;
        margin-top: 4px;
    }

    .qr-section .qr-info .qr-hint {
        font-size: 0.7rem;
        color: #a0aec0;
        margin-top: 2px;
    }

   
    .product-table {
        width: 100%;
        border-collapse: collapse;
        margin: 20px 0;
    }

    .product-table thead {
        background: #f7fafc;
    }

    .product-table thead th {
        padding: 12px 16px;
        text-align: left;
        font-size: 0.75rem;
        text-transform: uppercase;
        font-weight: 600;
        color: #4a5568;
        letter-spacing: 0.3px;
        border-bottom: 2px solid #e2e8f0;
    }

    .product-table tbody td {
        padding: 12px 16px;
        border-bottom: 1px solid #edf2f7;
    }

    .product-table tbody tr:last-child td {
        border-bottom: none;
    }

    .product-table .product-name {
        font-weight: 600;
        color: #2d3748;
    }

    .product-table .product-price {
        color: #2b6cb0;
        font-weight: 600;
    }

    .product-table .product-total {
        font-weight: 700;
        color: #2b6cb0;
    }

    
    .totals {
        display: flex;
        justify-content: flex-end;
        padding: 16px 0;
        border-top: 2px solid #edf2f7;
        margin-top: 16px;
    }

    .totals .total-row {
        display: flex;
        justify-content: space-between;
        gap: 40px;
        font-size: 1.1rem;
    }

    .totals .total-row .label {
        font-weight: 600;
        color: #1a202c;
    }

    .totals .total-row .amount {
        font-weight: 700;
        color: #2b6cb0;
        font-size: 1.3rem;
    }

  
    .slip-footer {
        margin-top: 32px;
        padding-top: 20px;
        border-top: 1px solid #e2e8f0;
        display: flex;
        justify-content: space-between;
        font-size: 0.8rem;
        color: #718096;
        flex-wrap: wrap;
        gap: 12px;
    }

    .slip-footer .signature {
        display: flex;
        gap: 40px;
    }

    .slip-footer .signature .sig-line {
        border-top: 1px solid #a0aec0;
        width: 120px;
        margin-top: 4px;
        padding-top: 4px;
        font-size: 0.7rem;
        color: #a0aec0;
        text-align: center;
    }

    .action-buttons {
        display: flex;
        gap: 12px;
        margin-top: 24px;
        flex-wrap: wrap;
    }

    .action-buttons .btn {
        padding: 10px 24px;
        border: none;
        border-radius: 8px;
        font-weight: 600;
        font-size: 0.9rem;
        cursor: pointer;
        transition: all 0.3s ease;
        display: inline-flex;
        align-items: center;
        gap: 8px;
        text-decoration: none;
    }

    .action-buttons .btn-print {
        background: #3182ce;
        color: white;
    }

    .action-buttons .btn-print:hover {
        background: #2b6cb0;
        transform: translateY(-2px);
        box-shadow: 0 4px 15px rgba(49, 130, 206, 0.3);
    }

    .action-buttons .btn-back {
        background: #edf2f7;
        color: #4a5568;
    }

    .action-buttons .btn-back:hover {
        background: #e2e8f0;
    }

    .action-buttons .btn-download {
        background: #27ae60;
        color: white;
    }

    .action-buttons .btn-download:hover {
        background: #2ecc71;
        transform: translateY(-2px);
        box-shadow: 0 4px 15px rgba(46, 204, 113, 0.3);
    }


    @media print {
        .main-navbar,
        .main-footer,
        .action-buttons,
        #notificationContainer,
        .guest-cart-banner {
            display: none !important;
        }

        .slip-page {
            margin: 0;
            padding: 0;
        }

        .slip-container {
            border: none;
            box-shadow: none;
            padding: 30px;
            border-radius: 0;
        }

        .slip-header .slip-type .status-badge {
            border: 1px solid #e2e8f0;
        }

        .slip-footer .signature .sig-line {
            border-top: 1px solid #000;
        }

        .qr-section {
            border: 1px dashed #000 !important;
            background: #f9fafb !important;
        }
    }

 
    @media (max-width: 768px) {
        .slip-page {
            padding: 12px;
        }

        .slip-container {
            padding: 20px;
        }

        .slip-header {
            flex-direction: column;
            text-align: center;
            gap: 12px;
        }

        .slip-header .slip-type {
            text-align: center;
        }

        .order-info-grid {
            grid-template-columns: 1fr;
            gap: 10px;
        }

        .slip-footer {
            flex-direction: column;
            text-align: center;
        }

        .slip-footer .signature {
            flex-direction: column;
            align-items: center;
            gap: 16px;
        }

        .action-buttons {
            justify-content: center;
        }

        .totals {
            justify-content: center;
        }

        .product-table {
            font-size: 0.85rem;
        }

        .product-table thead th,
        .product-table tbody td {
            padding: 8px 10px;
        }

        .qr-section {
            flex-direction: column;
            text-align: center;
        }

        .qr-section .qr-code {
            width: 100px;
            height: 100px;
        }
    }

    @media (max-width: 480px) {
        .slip-container {
            padding: 16px;
        }

        .slip-header .brand .logo {
            font-size: 1.2rem;
        }

        .product-table {
            font-size: 0.75rem;
        }

        .totals .total-row {
            font-size: 0.95rem;
            gap: 20px;
        }

        .totals .total-row .amount {
            font-size: 1.1rem;
        }

        .action-buttons .btn {
            padding: 8px 16px;
            font-size: 0.8rem;
        }

        .qr-section .qr-code {
            width: 80px;
            height: 80px;
        }
    }
</style>

<div class="slip-page">
    <div class="slip-container">


        <div class="slip-header">
            <div class="brand">
                <div>
                    <div class="logo">🛍️ BAGNEST</div>
                    <div class="sub">Quality Products Since 2024</div>
                </div>
            </div>
            <div class="slip-type">
                <h3>PACKING SLIP</h3>
                <span class="status-badge <%= order.status.toLowerCase() %>">
                    <%= order.status %>
                </span>
            </div>
        </div>

  
        <div class="order-info-grid">
            <div class="info-item">
                <div class="label">Order ID</div>
                <div class="value" style="font-family: monospace;">#<%= order.saleId %></div>
            </div>
            <div class="info-item">
                <div class="label">Date & Time</div>
                <div class="value"><%= order.orderDate %> at <%= order.orderTime %></div>
            </div>
            <div class="info-item">
                <div class="label">Customer</div>
                <div class="value"><%= order.customerName %></div>
            </div>
            <div class="info-item">
                <div class="label">Contact</div>
                <div class="value"><%= order.customerEmail %> <br /> <%= order.customerPhone %></div>
            </div>
            <div class="info-item" style="grid-column: 1 / -1;">
                <div class="label">Delivery Address</div>
                <div class="value"><%= order.customerAddress %></div>
            </div>
        </div>

        <div class="qr-section">
            <div class="qr-code">
                <img src="<%= qrImage %>" alt="Order QR Code" />
            </div>
            <div class="qr-info">
                <div class="qr-label">Scan to Update Status</div>
                <div class="qr-id">#<%= order.saleId %></div>
                <div class="qr-hint">
                    <i class="fas fa-mobile-alt"></i> 
                    Scan with BAGNEST App to update order status
                </div>
                <div style="margin-top: 6px; font-size: 0.7rem; color: #a0aec0;">
                    <span class="status-badge <%= order.status.toLowerCase() %>" style="font-size: 0.6rem; padding: 2px 8px;">
                        <%= order.status %>
                    </span>
                </div>
            </div>
        </div>


        <table class="product-table">
            <thead>
                <tr>
                    <th>#</th>
                    <th>Product Name</th>
                    <th style="text-align: right;">Price</th>
                    <th style="text-align: center;">Qty</th>
                    <th style="text-align: right;">Total</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td>1</td>
                    <td class="product-name"><%= order.productName %></td>
                    <td class="product-price" style="text-align: right;">BDT. <%= order.price.toFixed(2) %></td>
                    <td style="text-align: center;">× <%= order.quantity %></td>
                    <td class="product-total" style="text-align: right;">BDT. <%= order.totalAmount.toFixed(2) %></td>
                </tr>
            </tbody>
        </table>

 
        <div class="totals">
            <div class="total-row">
                <span class="label">Total Amount</span>
                <span class="amount">BDT. <%= order.totalAmount.toFixed(2) %></span>
            </div>
        </div>

 
        <div class="slip-footer">
            <div>
                <strong>Terms & Conditions:</strong><br />
                <span style="font-size: 0.75rem;">Items are subject to availability. Please check items upon delivery.</span>
            </div>
            <div class="signature">
                <div>
                    <div class="sig-line">Prepared By</div>
                </div>
                <div>
                    <div class="sig-line">Received By</div>
                </div>
            </div>
        </div>

        <div class="action-buttons">
            <button class="btn btn-print" onclick="window.print()">
                <i class="fas fa-print"></i> Print
            </button>
            <button class="btn btn-download" onclick="downloadPDF()">
                <i class="fas fa-file-pdf"></i> Download PDF
            </button>
            <a href="/my-orders" class="btn btn-back">
                <i class="fas fa-arrow-left"></i> Back
            </a>
        </div>

    </div>
</div>

<script>

    function downloadPDF() {
        const originalTitle = document.title;
        document.title = 'Packing-Slip-<%= order.saleId %>';
        window.print();
        document.title = originalTitle;
        showNotification('📄 PDF download started!', 'success');
    }


    function showNotification(message, type) {
        if (typeof window.showNotification === 'function') {
            window.showNotification(message, type);
        } else {
            alert(message);
        }
    }


    $(document).ready(function() {
        const urlParams = new URLSearchParams(window.location.search);
        if (urlParams.has('print') && urlParams.get('print') === 'true') {
            setTimeout(function() {
                window.print();
            }, 500);
        }
    });
</script>

<%- include('partials/footer') %>