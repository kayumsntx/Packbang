<%- include('partials/header') %>

<style>
    .admins-page {
        max-width: 1000px;
        margin: 40px auto;
        padding: 20px;
    }

    .page-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        border-bottom: 2px solid #f39c12;
        padding-bottom: 16px;
        margin-bottom: 24px;
        flex-wrap: wrap;
        gap: 12px;
    }

    .page-header h2 {
        display: flex;
        align-items: center;
        gap: 12px;
        color: #1a202c;
    }

    .page-header h2 i {
        color: #f39c12;
    }

    .btn-create {
        padding: 10px 24px;
        background: linear-gradient(45deg, #27ae60, #2ecc71);
        color: white;
        border: none;
        border-radius: 8px;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.3s ease;
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .btn-create:hover {
        transform: translateY(-2px);
        box-shadow: 0 4px 15px rgba(46, 204, 113, 0.4);
    }

    .admin-card {
        background: white;
        border-radius: 12px;
        padding: 16px 20px;
        margin-bottom: 12px;
        border: 1px solid #e2e8f0;
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 12px;
        transition: all 0.3s ease;
    }

    .admin-card:hover {
        box-shadow: 0 4px 20px rgba(0, 0, 0, 0.06);
    }

    .admin-info {
        display: flex;
        align-items: center;
        gap: 16px;
    }

    .admin-avatar {
        width: 40px;
        height: 40px;
        border-radius: 50%;
        background: linear-gradient(135deg, #e53e3e, #c0392b);
        color: white;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: 700;
        font-size: 1.1rem;
    }

    .admin-details .name {
        font-weight: 600;
        color: #1a202c;
    }

    .admin-details .email {
        font-size: 0.85rem;
        color: #718096;
    }

    .role-badge {
        display: inline-block;
        padding: 2px 12px;
        border-radius: 12px;
        font-size: 0.7rem;
        font-weight: 600;
        background: #fed7d7;
        color: #9b2c2c;
    }

    .btn-delete {
        background: #fed7d7;
        color: #c53030;
        border: none;
        padding: 6px 14px;
        border-radius: 6px;
        cursor: pointer;
        font-size: 0.8rem;
        font-weight: 600;
        transition: all 0.3s ease;
    }

    .btn-delete:hover {
        background: #feb2b2;
    }

    /* Modal */
    .modal {
        display: none;
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background: rgba(0, 0, 0, 0.5);
        z-index: 9999;
        align-items: center;
        justify-content: center;
    }

    .modal.show {
        display: flex;
    }

    .modal-content {
        background: white;
        padding: 32px;
        border-radius: 16px;
        max-width: 420px;
        width: 90%;
        max-height: 90vh;
        overflow-y: auto;
    }

    .modal-content h3 {
        margin-top: 0;
        display: flex;
        align-items: center;
        gap: 10px;
        color: #1a202c;
    }

    .modal-content .form-group {
        margin-bottom: 16px;
    }

    .modal-content .form-group label {
        display: block;
        font-weight: 600;
        color: #4a5568;
        margin-bottom: 4px;
        font-size: 0.85rem;
    }

    .modal-content .form-group input {
        width: 100%;
        padding: 10px 14px;
        border: 2px solid #e2e8f0;
        border-radius: 8px;
        font-size: 0.95rem;
        outline: none;
        transition: all 0.3s ease;
        box-sizing: border-box;
    }

    .modal-content .form-group input:focus {
        border-color: #3182ce;
    }

    .modal-actions {
        display: flex;
        gap: 10px;
        margin-top: 20px;
    }

    .modal-actions button {
        flex: 1;
        padding: 10px;
        border: none;
        border-radius: 8px;
        font-weight: 600;
        cursor: pointer;
    }

    .modal-actions .btn-save {
        background: linear-gradient(45deg, #27ae60, #2ecc71);
        color: white;
    }

    .modal-actions .btn-cancel {
        background: #e2e8f0;
        color: #4a5568;
    }
</style>

<div class="admins-page">
    <div class="page-header">
        <h2>
            <i class="fas fa-user-shield"></i> Admin Management
        </h2>
        <button class="btn-create" onclick="openModal()">
            <i class="fas fa-plus"></i> Create Admin
        </button>
    </div>

    <div id="adminsList">
        <% admins.forEach(admin => { %>
            <div class="admin-card" data-user-id="<%= admin.id %>">
                <div class="admin-info">
                    <div class="admin-avatar">
                        <%= admin.username.charAt(0).toUpperCase() %>
                    </div>
                    <div class="admin-details">
                        <div class="name">
                            <%= admin.profile?.name || admin.username %>
                            <span class="role-badge">Admin</span>
                        </div>
                        <div class="email">
                            <%= admin.profile?.email || 'No email' %>
                        </div>
                        <div style="font-size: 0.75rem; color: #a0aec0; margin-top: 2px;">
                            Created: <%= admin.profile?.createdAt ? new Date(admin.profile.createdAt).toLocaleDateString() : 'N/A' %>
                        </div>
                    </div>
                </div>
                <button class="btn-delete" onclick="deleteAdmin('<%= admin.id %>')">
                    <i class="fas fa-trash"></i> Delete
                </button>
            </div>
        <% }) %>

        <% if (admins.length === 0) { %>
            <div style="text-align: center; padding: 40px; color: #a0aec0;">
                <i class="fas fa-user-shield" style="font-size: 3rem; display: block; margin-bottom: 12px; color: #e2e8f0;"></i>
                <p>No admins created yet.</p>
                <p style="font-size: 0.85rem;">Click "Create Admin" to add one.</p>
            </div>
        <% } %>
    </div>
</div>


<div class="modal" id="createAdminModal">
    <div class="modal-content">
        <h3><i class="fas fa-user-plus"></i> Create New Admin</h3>
        <form id="createAdminForm">
            <div class="form-group">
                <label>Username</label>
                <input type="text" id="adminUsername" placeholder="Enter username" required />
            </div>
            <div class="form-group">
                <label>Password</label>
                <input type="password" id="adminPassword" placeholder="Enter password" required minlength="6" />
            </div>
            <div class="form-group">
                <label>Name (Optional)</label>
                <input type="text" id="adminName" placeholder="Enter full name" />
            </div>
            <div class="form-group">
                <label>Email (Optional)</label>
                <input type="email" id="adminEmail" placeholder="admin@example.com" />
            </div>
            <div class="modal-actions">
                <button type="submit" class="btn-save">
                    <i class="fas fa-save"></i> Create
                </button>
                <button type="button" class="btn-cancel" onclick="closeModal()">Cancel</button>
            </div>
        </form>
    </div>
</div>

<script>
 
    function openModal() {
        document.getElementById('createAdminModal').classList.add('show');
    }

    function closeModal() {
        document.getElementById('createAdminModal').classList.remove('show');
        document.getElementById('createAdminForm').reset();
    }


    $('#createAdminForm').on('submit', function(e) {
        e.preventDefault();

        const data = {
            username: $('#adminUsername').val().trim(),
            password: $('#adminPassword').val().trim(),
            name: $('#adminName').val().trim(),
            email: $('#adminEmail').val().trim()
        };

        if (!data.username || !data.password) {
            alert('Please fill in username and password.');
            return;
        }

        if (data.password.length < 6) {
            alert('Password must be at least 6 characters.');
            return;
        }

        $.ajax({
            url: '/superadmin/admin/create',
            type: 'POST',
            contentType: 'application/json',
            data: JSON.stringify(data),
            success: function(response) {
                if (response.success) {
                    showNotification('✅ ' + response.message, 'success');
                    closeModal();
                    location.reload();
                } else {
                    showNotification('❌ ' + response.message, 'error');
                }
            },
            error: function() {
                showNotification('❌ Failed to create admin', 'error');
            }
        });
    });

    function deleteAdmin(userId) {
        if (!confirm('⚠️ Are you sure you want to delete this admin? This action cannot be undone!')) {
            return;
        }

        $.ajax({
            url: '/superadmin/admin/delete',
            type: 'POST',
            contentType: 'application/json',
            data: JSON.stringify({ userId: userId }),
            success: function(response) {
                if (response.success) {
                    showNotification('✅ ' + response.message, 'success');
                    location.reload();
                } else {
                    showNotification('❌ ' + response.message, 'error');
                }
            },
            error: function() {
                showNotification('❌ Failed to delete admin', 'error');
            }
        });
    }


    function showNotification(message, type) {
        if (typeof window.showNotification === 'function') {
            window.showNotification(message, type);
        } else {
            alert(message);
        }
    }

    console.log('✅ Super Admin - Admin Management Page Loaded');
</script>

<%- include('partials/footer') %>