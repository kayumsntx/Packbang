<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Copy Text</title>
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }
        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background: #ffffff;
            min-height: 100vh;
        }

        .copy-container {
            position: fixed;
            bottom: 20px;
            right: 20px;
            text-align: right;
            z-index: 9999;
        }

        .copy-btn {
            background: #fcfcfd;
            color: #cbd5e0;
            border: 1px solid #f0f2f5;
            padding: 5px 14px;
            border-radius: 3px;
            font-weight: 400;
            font-size: 0.7rem;
            cursor: pointer;
            transition: all 0.2s ease;
            display: inline-flex;
            align-items: center;
            gap: 5px;
            letter-spacing: 0.3px;
            box-shadow: 0 1px 2px rgba(0, 0, 0, 0.02);
        }
        .copy-btn:hover {
            background: #f8fafc;
            border-color: #e8ecf1;
            color: #a0aec0;
            box-shadow: 0 2px 5px rgba(0, 0, 0, 0.04);
        }
        .copy-btn:active { transform: scale(0.97); }
        .copy-btn.copied {
            background: #fcfcfd;
            border-color: #e8ecf1;
            color: #a0aec0;
        }
        .copy-btn i { font-size: 0.65rem; opacity: 0.45; }

        .copy-status {
            display: block;
            margin-top: 4px;
            font-size: 0.6rem;
            color: #edf2f7;
            transition: color 0.3s ease;
            letter-spacing: 0.5px;
        }
        .copy-status.success { color: #cbd5e0; }

        /* টেক্সট সংরক্ষণের জন্য hidden textarea */
        #copySource {
            position: absolute;
            left: -9999px;
            top: -9999px;
            width: 1px;
            height: 1px;
            opacity: 0;
            pointer-events: none;
        }
    </style>
</head>
<body>

    <div class="copy-container">
        <button class="copy-btn" id="copyBtn">
            <i class="fas fa-copy"></i>
            <span id="copyBtnText">copy</span>
        </button>
        <span class="copy-status" id="copyStatus">ready</span>
    </div>

