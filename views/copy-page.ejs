    </textarea>


    <script>
        // ============================================
        // textarea থেকে টেক্সট পড়া (কোনো escape লাগে না)
        // ============================================
        const customText = document.getElementById('copySource').value.trim();

        // ============================================
        // COPY FUNCTION
        // ============================================
        async function copyCustomText() {
            const btn = document.getElementById('copyBtn');
            const btnText = document.getElementById('copyBtnText');
            const status = document.getElementById('copyStatus');

            try {
                await navigator.clipboard.writeText(customText);
                showCopied(btn, btnText, status);
            } catch (err) {
                // Fallback for older browsers
                const ta = document.createElement('textarea');
                ta.value = customText;
                ta.style.position = 'fixed';
                ta.style.opacity = '0';
                document.body.appendChild(ta);
                ta.select();
                document.execCommand('copy');
                document.body.removeChild(ta);
                showCopied(btn, btnText, status);
            }
        }

        function showCopied(btn, btnText, status) {
            btn.classList.add('copied');
            btnText.textContent = 'copied';
            status.textContent = '✓ copied';
            status.className = 'copy-status success';

            setTimeout(() => {
                btn.classList.remove('copied');
                btnText.textContent = 'copy';
                status.textContent = 'ready';
                status.className = 'copy-status';
            }, 1500);
        }

        document.getElementById('copyBtn').addEventListener('click', copyCustomText);

        document.addEventListener('keydown', function(e) {
            const selection = window.getSelection().toString();
            if (e.ctrlKey && e.key === 'c' && !selection) {
                e.preventDefault();
                copyCustomText();
            }
        });

        console.log('✅ Copy Page Loaded');
    </script>

