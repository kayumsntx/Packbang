<%- include('partials/header') %>

<style>
    .super-dashboard {
        max-width: 1200px;
        margin: 40px auto;
        padding: 20px;
    }

    .welcome-banner {
        background: linear-gradient(135deg, #1a202c, #2d3748);
        color: white;
        padding: 30px 40px;
        border-radius: 16px;
        margin-bottom: 30px;
    }

    .welcome-banner h1 {
        display: flex;
        align-items: center;
        gap: 12px;
    }

    .welcome-banner h1 i {
        color: #f39c12;
    }

    .alert-danger {
        background: #e53e3e;
        padding: 12px 20px;
        border-radius: 8px;
        margin-top: 12px;
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .stats-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
        gap: 20px;
        margin-bottom: 30px;
    }

    .stat-card {
        background: white;
        padding: 20px;
        border-radius: 12px;
        border: 1px solid #e2e8f0;
        text-align: center;
        transition: all 0.3s ease;
    }

    .stat-card:hover {
        transform: translateY(-3px);
        box-shadow: 0 4px 20px rgba(0, 0, 0, 0.06);
    }

    .stat-card .number {
        font-size: 2rem;
        font-weight: 700;
        color: #2b6cb0;
        display: block;
    }

    .stat-card .label {
        color: #718096;
        font-size: 0.85rem;
        margin-top: 4px;
    }

    .stat-card .icon {
        font-size: 1.5rem;
        color: #f39c12;
        margin-bottom: 8px;
    }

    .quick-actions {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
        gap: 20px;
        margin-top: 30px;
    }

    .quick-action {
        background: white;
        padding: 24px;
        border-radius: 12px;
        border: 1px solid #e2e8f0;
        text-decoration: none;
        color: #1a202c;
        transition: all 0.3s ease;
        display: flex;
        align-items: center;
        gap: 16px;
    }

    .quick-action:hover {
        transform: translateY(-3px);
        box-shadow: 0 4px 20px rgba(0, 0, 0, 0.06);
        border-color: #f39c12;
    }

    .quick-action i {
        font-size: 2rem;
        color: #f39c12;
        width: 50px;
        text-align: center;
    }

    .quick-action .action-text {
        flex: 1;
    }

    .quick-action .action-text h4 {
        margin: 0;
        font-size: 1rem;
    }

    .quick-action .action-text p {
        margin: 4px 0 0 0;
        font-size: 0.85rem;
        color: #718096;
    }

    @media (max-width: 768px) {
        .stats-grid {
            grid-template-columns: repeat(2, 1fr);
        }

        .quick-actions {
            grid-template-columns: 1fr;
        }
    }
</style>

<div class="super-dashboard">

    <div class="welcome-banner">
        <h1>
            <i class="fas fa-crown"></i> Super Admin Dashboard
        </h1>
        <p>Welcome back, <strong><%= user.username %></strong>! Here's your system overview.</p>
        
        <% if (requirePasswordChange) { %>
            <div class="alert-danger">
                <i class="fas fa-exclamation-triangle"></i>
                <span>
                    <strong>Security Alert!</strong> Please change your default password immediately.
                    <a href="/profile" style="color: white; font-weight: bold; text-decoration: underline; margin-left: 10px;">
                        Change Password →
                    </a>
                </span>
            </div>
        <% } %>
    </div>

 
    <div class="stats-grid">
        <div class="stat-card">
            <div class="icon"><i class="fas fa-users"></i></div>
            <span class="number"><%= stats.totalUsers %></span>
            <span class="label">Total Users</span>
        </div>
        <div class="stat-card">
            <div class="icon"><i class="fas fa-box"></i></div>
            <span class="number"><%= stats.totalProducts %></span>
            <span class="label">Total Products</span>
        </div>
        <div class="stat-card">
            <div class="icon"><i class="fas fa-shopping-cart"></i></div>
            <span class="number"><%= stats.totalOrders %></span>
            <span class="label">Total Orders</span>
        </div>
        <div class="stat-card">
            <div class="icon"><i class="fas fa-money-bill-wave"></i></div>
            <span class="number">BDT. <%= stats.totalRevenue.toFixed(2) %></span>
            <span class="label">Total Revenue</span>
        </div>
        <div class="stat-card">
            <div class="icon"><i class="fas fa-user-shield"></i></div>
            <span class="number"><%= stats.adminCount %></span>
            <span class="label">Admins</span>
        </div>
        <div class="stat-card">
            <div class="icon"><i class="fas fa-clock"></i></div>
            <span class="number"><%= stats.pendingOrders %></span>
            <span class="label">Pending Orders</span>
        </div>
    </div>

   
    <h3 style="color: #1a202c; margin-bottom: 20px;">
        <i class="fas fa-bolt"></i> Quick Actions
    </h3>
    <div class="quick-actions">
        <a href="/superadmin/admins" class="quick-action">
            <i class="fas fa-user-shield"></i>
            <div class="action-text">
                <h4>Manage Admins</h4>
                <p>Create or remove admin accounts</p>
            </div>
        </a>
        <a href="/admin/users" class="quick-action">
            <i class="fas fa-users-cog"></i>
            <div class="action-text">
                <h4>All Users</h4>
                <p>Manage all user accounts</p>
            </div>
        </a>
        <a href="/admin/inventory" class="quick-action">
            <i class="fas fa-warehouse"></i>
            <div class="action-text">
                <h4>Inventory</h4>
                <p>Manage products and stock</p>
            </div>
        </a>
        <a href="/sales" class="quick-action">
            <i class="fas fa-chart-bar"></i>
            <div class="action-text">
                <h4>Sales Reports</h4>
                <p>View all sales transactions</p>
            </div>
        </a>
        <a href="/profile" class="quick-action">
            <i class="fas fa-user-edit"></i>
            <div class="action-text">
                <h4>Profile Settings</h4>
                <p>Change password and update profile</p>
            </div>
        </a>
    </div>
</div>

<%- include('partials/footer') %>