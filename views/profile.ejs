<%- include('partials/header') %>

<style>

    .profile-page {
        max-width: 800px;
        margin: 40px auto;
        padding: 20px;
    }

    .profile-card {
        background: white;
        border-radius: 16px;
        padding: 32px;
        box-shadow: 0 4px 30px rgba(0, 0, 0, 0.08);
        border: 1px solid #e2e8f0;
    }

    .profile-header {
        display: flex;
        align-items: center;
        gap: 24px;
        padding-bottom: 24px;
        border-bottom: 2px solid #f39c12;
        margin-bottom: 28px;
        flex-wrap: wrap;
    }

    .profile-avatar {
        width: 80px;
        height: 80px;
        border-radius: 50%;
        background: linear-gradient(135deg, #3182ce, #2b6cb0);
        display: flex;
        align-items: center;
        justify-content: center;
        color: white;
        font-size: 2.2rem;
        font-weight: 700;
        flex-shrink: 0;
        position: relative;
        overflow: hidden;
    }

    .profile-avatar img {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }

    .profile-avatar .avatar-upload {
        position: absolute;
        bottom: 0;
        left: 0;
        right: 0;
        background: rgba(0, 0, 0, 0.6);
        color: white;
        font-size: 0.6rem;
        text-align: center;
        padding: 4px 0;
        cursor: pointer;
        opacity: 0;
        transition: opacity 0.3s ease;
    }

    .profile-avatar:hover .avatar-upload {
        opacity: 1;
    }

    .profile-avatar .avatar-upload input {
        display: none;
    }

    .profile-title h2 {
        margin: 0;
        color: #1a202c;
        font-size: 1.5rem;
        font-weight: 700;
    }

    .profile-title p {
        margin: 4px 0 0 0;
        color: #718096;
        font-size: 0.9rem;
    }

    .profile-title .role-badge {
        display: inline-block;
        background: #ebf8ff;
        color: #2a69ac;
        padding: 2px 12px;
        border-radius: 20px;
        font-size: 0.7rem;
        font-weight: 600;
        margin-top: 4px;
    }

    .form-section {
        margin-bottom: 32px;
    }

    .form-section h3 {
        color: #1a202c;
        font-size: 1.1rem;
        font-weight: 700;
        margin-bottom: 16px;
        padding-bottom: 8px;
        border-bottom: 1px solid #edf2f7;
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .form-section h3 i {
        color: #f39c12;
    }

    .form-row {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 16px;
    }

    .form-group {
        margin-bottom: 16px;
    }

    .form-group label {
        display: block;
        font-weight: 600;
        color: #4a5568;
        margin-bottom: 6px;
        font-size: 0.85rem;
    }

    .form-group label i {
        margin-right: 6px;
        color: #718096;
    }

    .form-group input,
    .form-group textarea {
        width: 100%;
        padding: 10px 14px;
        border: 2px solid #e2e8f0;
        border-radius: 8px;
        font-size: 0.95rem;
        outline: none;
        transition: all 0.3s ease;
        box-sizing: border-box;
        font-family: inherit;
        background: #f7fafc;
    }

    .form-group input:focus,
    .form-group textarea:focus {
        border-color: #3182ce;
        background: white;
        box-shadow: 0 0 0 3px rgba(49, 130, 206, 0.15);
    }

    .form-group textarea {
        resize: vertical;
        min-height: 70px;
    }


    .password-section {
        background: #f7fafc;
        border-radius: 12px;
        padding: 20px;
        border: 1px solid #edf2f7;
        margin-top: 8px;
    }

    .password-section .form-group {
        margin-bottom: 12px;
    }

    .password-section .form-group:last-child {
        margin-bottom: 0;
    }


    .btn-save {
        width: 100%;
        padding: 14px;
        background: linear-gradient(45deg, #27ae60, #2ecc71);
        color: white;
        border: none;
        border-radius: 10px;
        font-size: 1rem;
        font-weight: 700;
        cursor: pointer;
        transition: all 0.3s ease;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 10px;
    }

    .btn-save:hover {
        transform: translateY(-2px);
        box-shadow: 0 4px 20px rgba(46, 204, 113, 0.4);
    }

    .btn-save:disabled {
        opacity: 0.6;
        cursor: not-allowed;
        transform: none !important;
        box-shadow: none !important;
    }

    .btn-password {
        padding: 10px 20px;
        background: #4a5568;
        color: white;
        border: none;
        border-radius: 8px;
        font-weight: 600;
        font-size: 0.9rem;
        cursor: pointer;
        transition: all 0.3s ease;
        display: inline-flex;
        align-items: center;
        gap: 8px;
    }

    .btn-password:hover {
        background: #2d3748;
    }

    .btn-password.cancel {
        background: #e53e3e;
    }

    .btn-password.cancel:hover {
        background: #c0392b;
    }

 
    .alert-success {
        background: #d4edda;
        color: #155724;
        padding: 12px 16px;
        border-radius: 8px;
        margin-bottom: 16px;
        display: none;
        align-items: center;
        gap: 10px;
        border-left: 4px solid #28a745;
    }

    .alert-success.show {
        display: flex;
    }

    .alert-error {
        background: #f8d7da;
        color: #721c24;
        padding: 12px 16px;
        border-radius: 8px;
        margin-bottom: 16px;
        display: none;
        align-items: center;
        gap: 10px;
        border-left: 4px solid #dc3545;
    }

    .alert-error.show {
        display: flex;
    }


    @media (max-width: 768px) {
        .profile-page {
            padding: 12px;
        }

        .profile-card {
            padding: 20px;
        }

        .profile-header {
            flex-direction: column;
            text-align: center;
            gap: 12px;
        }

        .form-row {
            grid-template-columns: 1fr;
            gap: 0;
        }

        .profile-title .role-badge {
            display: inline-block;
        }
    }

    @media (max-width: 480px) {
        .profile-card {
            padding: 16px;
        }

        .profile-avatar {
            width: 64px;
            height: 64px;
            font-size: 1.8rem;
        }

        .profile-title h2 {
            font-size: 1.2rem;
        }

        .btn-password {
            width: 100%;
            justify-content: center;
        }
    }
</style>


<div class="profile-page">
    <div class="profile-card">

        
        <div class="alert-success" id="successMsg">
            <i class="fas fa-check-circle"></i>
            <span id="successText">Profile updated successfully!</span>
        </div>
        <div class="alert-error" id="errorMsg">
            <i class="fas fa-exclamation-circle"></i>
            <span id="errorText">Something went wrong. Please try again.</span>
        </div>

        <div class="profile-header">
            
            <div class="profile-avatar" id="avatarContainer">
                <% 
                    const userProfile = typeof profile !== 'undefined' ? profile : {};
                    const userName = userProfile.name || user.username || 'User';
                    const initial = userName.charAt(0).toUpperCase();
                    const avatarImage = userProfile.avatar || '';
                %>
                <% if (avatarImage) { %>
                    <img src="<%= avatarImage %>" alt="Profile Picture" id="avatarPreview" />
                <% } else { %>
                    <span id="avatarInitial"><%= initial %></span>
                <% } %>
                <div class="avatar-upload" onclick="document.getElementById('avatarInput').click()">
                    <i class="fas fa-camera"></i> Change
                    <input type="file" id="avatarInput" accept="image/*" />
                </div>
            </div>

         
            <div class="profile-title">
                <h2><%= userName %></h2>
                <p><i class="fas fa-envelope"></i> <%= userProfile.email || user.email || 'No email set' %></p>
                <span class="role-badge">
                    <i class="fas fa-user-tag"></i>
                    <%= typeof user !== 'undefined' && user ? user.role || 'User' : 'User' %>
                </span>
            </div>
        </div>

   
        <form id="profileForm">

            
            <div class="form-section">
                <h3><i class="fas fa-user-circle"></i> Personal Information</h3>
                <div class="form-row">
                    <div class="form-group">
                        <label><i class="fas fa-user"></i> Full Name</label>
                        <input type="text" id="profileName" value="<%= userProfile.name || '' %>" placeholder="Your full name" />
                    </div>
                    <div class="form-group">
                        <label><i class="fas fa-envelope"></i> Email Address</label>
                        <input type="email" id="profileEmail" value="<%= userProfile.email || '' %>" placeholder="your@email.com" />
                    </div>
                </div>
                <div class="form-row">
                    <div class="form-group">
                        <label><i class="fas fa-phone"></i> Phone Number</label>
                        <input type="tel" id="profilePhone" value="<%= userProfile.phone || '' %>" placeholder="+880 1XXX-XXXXXX" />
                    </div>
                </div>
            </div>

          
            <div class="form-section">
                <h3><i class="fas fa-shipping-fast"></i> Checkout Defaults</h3>
                <div class="form-group">
                    <label><i class="fas fa-map-marker-alt"></i> Default Delivery Address</label>
                    <textarea id="profileAddress" rows="3" placeholder="Your default delivery address"><%= userProfile.address || '' %></textarea>
                </div>
                <p style="font-size: 0.8rem; color: #718096; margin-top: -8px;">
                    <i class="fas fa-info-circle"></i> This address will be pre-filled during checkout.
                </p>
            </div>

            <div class="form-section">
                <h3><i class="fas fa-key"></i> Change Password</h3>
                <div class="password-section" id="passwordSection">
                    <div class="form-group">
                        <label><i class="fas fa-lock"></i> Current Password</label>
                        <input type="password" id="currentPassword" placeholder="Enter your current password" />
                    </div>
                    <div class="form-row">
                        <div class="form-group">
                            <label><i class="fas fa-key"></i> New Password</label>
                            <input type="password" id="newPassword" placeholder="Enter new password" />
                        </div>
                        <div class="form-group">
                            <label><i class="fas fa-check-circle"></i> Confirm New Password</label>
                            <input type="password" id="confirmPassword" placeholder="Confirm new password" />
                        </div>
                    </div>
                    <div style="margin-top: 12px; display: flex; gap: 10px; flex-wrap: wrap;">
                        <button type="button" class="btn-password" onclick="updatePassword()">
                            <i class="fas fa-save"></i> Update Password
                        </button>
                        <button type="button" class="btn-password cancel" onclick="clearPasswordFields()">
                            <i class="fas fa-times"></i> Clear
                        </button>
                    </div>
                </div>
            </div>

         
            <button type="submit" class="btn-save" id="saveBtn">
                <i class="fas fa-save"></i> Save Profile
            </button>
        </form>

    </div>
</div>


<script>
$(document).ready(function() {

  
    $('#profileForm').on('submit', function(e) {
        e.preventDefault();

        const $btn = $('#saveBtn');
        $btn.prop('disabled', true);
        $btn.html('<i class="fas fa-spinner fa-spin"></i> Saving...');

        const data = {
            name: $('#profileName').val().trim(),
            email: $('#profileEmail').val().trim(),
            phone: $('#profilePhone').val().trim(),
            address: $('#profileAddress').val().trim()
        };

        $.ajax({
            url: '/api/profile/update',
            type: 'POST',
            contentType: 'application/json',
            data: JSON.stringify(data),
            success: function(response) {
                if (response.success) {
                    showSuccess('Profile updated successfully!');
                  
                    if (data.name) {
                        $('#avatarInitial').text(data.name.charAt(0).toUpperCase());
                    }
                } else {
                    showError(response.message || 'Failed to update profile');
                }
            },
            error: function(xhr) {
                const msg = xhr.responseJSON?.message || 'Server error. Please try again.';
                showError(msg);
            },
            complete: function() {
                $btn.prop('disabled', false);
                $btn.html('<i class="fas fa-save"></i> Save Profile');
            }
        });
    });

   
    $('#avatarInput').on('change', function() {
        const file = this.files[0];
        if (!file) return;

        
        const reader = new FileReader();
        reader.onload = function(e) {
            const preview = $('#avatarPreview');
            const initial = $('#avatarInitial');
            const container = $('#avatarContainer');
            
            if (preview.length) {
                preview.attr('src', e.target.result);
            } else {
                container.prepend('<img src="' + e.target.result + '" alt="Profile Picture" id="avatarPreview" />');
                initial.hide();
            }
        };
        reader.readAsDataURL(file);

       
        const formData = new FormData();
        formData.append('avatar', file);

        $.ajax({
            url: '/api/profile/avatar',
            type: 'POST',
            data: formData,
            processData: false,
            contentType: false,
            success: function(response) {
                if (response.success) {
                    showSuccess('Profile picture updated!');
                }
            },
            error: function() {
                showError('Failed to upload profile picture');
            }
        });
    });

    window.updatePassword = function() {
        const current = $('#currentPassword').val();
        const newPass = $('#newPassword').val();
        const confirm = $('#confirmPassword').val();

        if (!current || !newPass || !confirm) {
            showError('Please fill in all password fields');
            return;
        }

        if (newPass.length < 6) {
            showError('New password must be at least 6 characters');
            return;
        }

        if (newPass !== confirm) {
            showError('New passwords do not match');
            return;
        }

        $.ajax({
            url: '/api/profile/password',
            type: 'POST',
            contentType: 'application/json',
            data: JSON.stringify({
                currentPassword: current,
                newPassword: newPass
            }),
            success: function(response) {
                if (response.success) {
                    showSuccess('Password updated successfully!');
                    clearPasswordFields();
                } else {
                    showError(response.message || 'Failed to update password');
                }
            },
            error: function(xhr) {
                const msg = xhr.responseJSON?.message || 'Server error. Please try again.';
                showError(msg);
            }
        });
    };

    window.clearPasswordFields = function() {
        $('#currentPassword').val('');
        $('#newPassword').val('');
        $('#confirmPassword').val('');
    };

  
    function showSuccess(message) {
        const $msg = $('#successMsg');
        $('#successText').text(message);
        $msg.addClass('show');
        $msg.removeClass('show');
        // Force reflow
        void $msg[0].offsetWidth;
        $msg.addClass('show');
        setTimeout(function() {
            $msg.removeClass('show');
        }, 4000);
    }

    function showError(message) {
        const $msg = $('#errorMsg');
        $('#errorText').text(message);
        $msg.addClass('show');
        $msg.removeClass('show');
        void $msg[0].offsetWidth;
        $msg.addClass('show');
        setTimeout(function() {
            $msg.removeClass('show');
        }, 4000);
    }

   
    $('#profileName, #profileEmail, #profilePhone, #profileAddress').on('keypress', function(e) {
        if (e.which === 13 && !e.shiftKey) {
            e.preventDefault();
            $('#profileForm').submit();
        }
    });

    console.log('✅ Profile Page Loaded');
});
</script>

<%- include('partials/footer') %>